{
  "name": "wayfarer",
  "version": "0.1.9",
  "description": "Trip planning in Obsidian: paste Google Maps links, write days as headings, see the plan on a map beside the note.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "author": "Kevin Lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinsslin/wayfarer.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "travel",
    "itinerary",
    "map",
    "leaflet"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint styles.css",
    "test": "vitest run",
    "smoke": "node scripts/load-smoke.mjs",
    "check": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "bump": "node version-bump.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.34.0",
    "@eslint/js": "^9.15.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.2.0"
  }
}
